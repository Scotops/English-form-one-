{
  "pg039_im005_crop_v1": {
    "text": "Long vowel words table. Long ‘a’, /ɑː/: bar, car, tar, far, star, cigar, scar, mart, cart, dart. Long ‘a’, /eɪ/: bake, cake, lake, fake, grate, bake, baby, play, maid, jail. Long ‘e’, /iː/: tree, bee, feel, be, sea, seen, beach, clean, steal, read. Long ‘i’, /aɪ/: shine, pine, light, tie, fine, why, delight, white, nice, apply. Long ‘o’, /ɔː/: more, shore, chore, sore, core, door, store, straw, phone, roast. Long ‘u’, /uː/: food, human, soup, school, uniform, blue, huge, fruit, cute, room.",
    "filename": "pg039_im005_crop_v1.mp3"
  },
  "pg064_im001": {
    "text": "Vocabulary bingo card. Row one: apartment, intend, opinion, labour, repair. Row two: indulge, embrace, summary, rapid, vivid. Row three: avail, urgent, BINGO, occupation, portion. Row four: weary, pledge, hygiene, essential, awful. Row five: exhaust, compile, accurate, similar, recycle. Colored markers are placed on avail, pledge, hygiene, and awful.",
    "filename": "pg064_im001.mp3"
  },
  "pg067_im004": {
    "text": "Health-related word-search grid. Read each row from left to right: c a s t d i a g n o s i s; b x y b q e t y o p u f h; u z r w y w o u n d r g e; r a i q d u k o q o g n a; n d n u r s e l d c e q l; e f g z h e l y i t o p t; p r e s r i p t i o n j h; p a i n k i l l e r z v q; j k m f g m e d i c i n e.",
    "filename": "pg067_im004.mp3"
  },
